# ========================================================
# LMS CyberSekurity - Environment Production Configuration
# ========================================================

# Port server (default: 3000 atau sesuai port dari VPS / PaaS)
PORT=3000

# Mode Aplikasi: 'production' untuk mengaktifkan cookie HTTPS secure dan pengetatan keamanan
NODE_ENV=production

# Kunci Rahasia Sesi (Gunakan string acak minimal 32 karakter untuk melindungi session cookies)
# Contoh generate kunci acak di terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=ganti_dengan_kunci_acak_super_aman_minimal_32_karakter_2026
