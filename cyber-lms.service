[Unit]
Description=Cyber Security Academy LMS Application
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/cyber-sekurity
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=3000

[Install]
WantedBy=multi-user.target
